<Window x:Class="GestioneSicurezze.RicercaSicurezza"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneSicurezze"         
        xmlns:uc="clr-namespace:GestioneSicurezze.MyUserControl"         
        mc:Ignorable="d"
        Title="Mezzapesa - Ricerca Sicurezze" SizeToContent="WidthAndHeight"
        Background="#F7F8E2" WindowStartupLocation="CenterScreen">   
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="75"/>            
            <RowDefinition Height="5"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="100"/>            
            <RowDefinition Height="5"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="75"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        
        <!--#region Campi Ricerca-->
        <Border Style="{StaticResource BorderStyle}"
                Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal">
                <Label Style="{DynamicResource LabelStyle}" Content="RICERCA SICUREZZE" FontSize="16"
                       FontWeight="Bold" HorizontalAlignment="Left" Margin="5,0"/>
                <TextBox Name="txtRicercaSicurezza" FontFamily="Verdana" FontSize="16" FontWeight="Bold"
                         VerticalContentAlignment="Center" Height="50"
                         HorizontalAlignment="Left" Margin="5,5" Width="400"/>
                <Button Name="btnCercaSicurezza" Content="CERCA" Margin="10,5"
                        Style="{StaticResource ButtonStyle}" Width="150" Height="50" Click="btnCercaSicurezza_Click"/>
            </StackPanel>
        </Border>
        <!--#endregion-->

        <!--#region Riga Progressivo CodiceEU Operatore Cliente-->
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Margin="5,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Style="{DynamicResource LabelStyle}" Content="PROGRESSIVO:"></Label>
                    <TextBlock Name="txtProgressivo" FontFamily="Verdana" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center"></TextBlock>
                </StackPanel>
                
                    <StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
                        <Label Style="{DynamicResource LabelStyle}" Content="CODICE EU:"></Label>
                        <TextBlock x:Name="txtCodiceEU" FontFamily="Verdana" VerticalAlignment="Center"
                          FontSize="20" FontWeight="Bold" Width="230">
                        </TextBlock>
                    </StackPanel>
                
                    <StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
                        <Label Style="{DynamicResource LabelStyle}" Content="OPERATORE:"></Label>
                        <TextBlock x:Name="txtOperatori" FontFamily="Verdana"
                                   FontSize="20" FontWeight="Bold" Width="75">
                        </TextBlock>
                    </StackPanel>
                
                    <StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
                        <Label Style="{DynamicResource LabelStyle}" Content="SPEDIZIONE AFFIDATA DA:"></Label>
                        <TextBlock x:Name="txtCliente"
                                   FontFamily="Verdana" FontSize="20"
                                   FontWeight="Bold" Width="360">
                        </TextBlock>
                    </StackPanel>
            </StackPanel>
        </Border>
        <!--#endregion-->
        
        <!--#region ENTRATA AWB COLLI KG DEST CONTENUTO-->
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,0">
                <Border BorderThickness="1,0" BorderBrush="Black">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Label Content="ENTRATA NR." HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="0" Grid.Row="0" />
                        <Label Content="AWB" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="1" Grid.Row="0" />
                        <Label Content="COLLI" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="2" Grid.Row="0" />
                        <Label Content="KG" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="3" Grid.Row="0" />
                        <Label Content="DEST" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="4" Grid.Row="0" />
                        <Label Content="CONTENUTO" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="5" Grid.Row="0" />

                        <Border Grid.Column="0" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                            <TextBlock x:Name="txtEntrata" Style="{DynamicResource TextBlockStyle}"></TextBlock>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">                            
                                <TextBlock Style="{DynamicResource TextBlockStyle}" x:Name="txtAwb"/>                            
                        </Border>
                        <Border Grid.Column="2" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                            <TextBlock Style="{DynamicResource TextBlockStyle}" x:Name="txtColli"></TextBlock>                            
                        </Border>
                        <Border Grid.Column="3" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                            <TextBlock x:Name="txtPeso" Style="{DynamicResource TextBlockStyle}"></TextBlock>                            
                        </Border>
                        <Border Grid.Column="4" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                            <TextBlock x:Name="txtDestinazione" Style="{DynamicResource TextBlockStyle}"></TextBlock>                                
                        </Border>
                        <Border Grid.Column="5" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                            <TextBlock x:Name="txtContenuto" Style="{DynamicResource TextBlockStyle}"></TextBlock>                            
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <!--#endregion-->

        <!--#region Compilazione Riferimenti-->
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="7">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="250"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="250"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="250"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition Height="10"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Label Style="{DynamicResource LabelStyle}" Grid.Column="0" Grid.Row="0"
                           Content="Riferimento:"></Label>
                    <TextBlock x:Name="txtRiferimento" Grid.Column="1" Grid.Row="0"
                               Style="{DynamicResource TextBlockStyle}" Margin="5,0"></TextBlock>
                    <Label Style="{DynamicResource LabelStyle}" Grid.Column="2" Grid.Row="0"
                           Content="Trasportatore/Rag. Soc.:"></Label>
                    <TextBlock x:Name="txtRagSocTrasp" Grid.Column="3" Grid.Row="0"
                             Style="{DynamicResource TextBlockStyle}" Margin="5,0"></TextBlock>
                    <Label Style="{DynamicResource LabelStyle}" Grid.Column="4" Grid.Row="0"
                           Content="Targhe:"></Label>
                    <TextBlock x:Name="txtTarghe" Grid.Column="5" Grid.Row="0"
                               Style="{DynamicResource TextBlockStyle}" Margin="5,0"></TextBlock>
                    <Label Style="{DynamicResource LabelStyle}" Grid.Column="0" Grid.Row="2"
                           Content="Sigillo Numero:"></Label>
                    <TextBlock x:Name="txtSigilloNumero" Grid.Column="1" Grid.Row="2"
                               Style="{DynamicResource TextBlockStyle}" Margin="5,0"></TextBlock>
                    <Label Style="{DynamicResource LabelStyle}" Grid.Column="2" Grid.Row="2"
                           Content="Autista:"></Label>
                    <TextBlock x:Name="txtAutista" Grid.Column="3" Grid.Row="2"
                               Style="{DynamicResource TextBlockStyle}" Margin="5,0"></TextBlock>
                </Grid>
            </StackPanel>
        </Border>
        <!--#endregion-->

        <!--#region Check Xray-->
        <Border Style="{StaticResource BorderStyle}"
                Grid.Column="1" Grid.Row="9" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5,5">
                <!--#region XRAY-->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="75"></ColumnDefinition>
                            <ColumnDefinition Width="75"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Style="{DynamicResource LabelStyle}" HorizontalAlignment="Center"
                               Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                               Content="TIPO ISPEZIONE"></Label>
                        <Label Style="{DynamicResource LabelStyle}" HorizontalAlignment="Center"
                               Grid.Column="2" Grid.Row="0"
                               Content="QT."></Label>
                        
                        <Label Style="{DynamicResource LabelStyle}" Content="XRAY:" Grid.Column="0" Grid.Row="1"
                               Padding="10"></Label>                        
                        <TextBlock x:Name="txtXray" Style="{DynamicResource TextBlockStyle}"
                                Grid.Column="1" Grid.Row="1"></TextBlock>
                        <TextBlock x:Name="txtQtXray" Style="{DynamicResource TextBlockStyle}"
                                   Grid.Column="2" Grid.Row="1"></TextBlock>
                        
                        <Label Content="ETD:" Style="{DynamicResource LabelStyle}" Padding="10"
                                Grid.Column="0" Grid.Row="2"></Label>
                        <TextBlock x:Name="txtEtd" Style="{DynamicResource TextBlockStyle}"
                                Grid.Column="1" Grid.Row="2"></TextBlock>
                        <TextBlock x:Name="txtQtEtd" Style="{DynamicResource TextBlockStyle}"
                                   Grid.Column="2" Grid.Row="2"></TextBlock>
                        
                        <Label Content="PHS (Ispezione Manuale):" Style="{DynamicResource LabelStyle}" Padding="10"
                                Grid.Column="0" Grid.Row="3"></Label>
                        <TextBlock x:Name="txtPhs" Style="{DynamicResource TextBlockStyle}"
                                Grid.Column="1" Grid.Row="3"></TextBlock>
                        
                        <Label Content="VCK (Ispezione Visiva Completa):" Style="{DynamicResource LabelStyle}" Padding="10"
                                Grid.Column="0" Grid.Row="4"></Label>
                        <TextBlock x:Name="txtVck" Style="{DynamicResource TextBlockStyle}"
                                Grid.Column="1" Grid.Row="4"></TextBlock>
                    </Grid>                    
                    </StackPanel>                
                <!--#endregion-->
                
                <!--#region STATO DELLA MERCE-->
                <StackPanel Margin="150,5,5,5">
                    <Label Style="{DynamicResource LabelStyle}" HorizontalAlignment="Center"
                           Content="STATO DELLA MERCE"></Label>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="75"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>                            
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Content="SPX (sicura per ogni tipo di aeromobile)" Style="{DynamicResource LabelStyle}"
                                Grid.Column="0" Grid.Row="0" Padding="10"/>
                        <TextBlock x:Name="txtSpx" Style="{DynamicResource TextBlockStyle}" Grid.Column="1" Grid.Row="0" />
                        <Label Content="SHR (sicura solo per trasporto con aeromobili &quot;all cargo&quot; o postali)"
                                Grid.Column="0" Grid.Row="1" Style="{DynamicResource LabelStyle}" Padding="10"/>
                        <TextBlock x:Name="txtShr" Style="{DynamicResource TextBlockStyle}" Grid.Column="1" Grid.Row="1"/>
                    </Grid>
                </StackPanel>
                <!--#endregion-->
                
            </StackPanel>
        </Border>
        <!--#endregion-->

        <!--#region ORA/DATA DESTINAZIONE -->
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="11" Grid.ColumnSpan="3">            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Style="{DynamicResource LabelStyle}" Content="Data/Ora Rilascio sicurezza:"></Label>
                    <TextBlock x:Name="txtDataOra" Style="{DynamicResource TextBlockStyle}"
                               Width="300" Margin="5,0" ></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0">
                    <Label Style="{DynamicResource LabelStyle}" Content="Aeroporto Destinazione:"></Label>
                    <TextBlock x:Name="txtAeroporto" Style="{DynamicResource TextBlockStyle}"
                               Width="300" Margin="5,0"></TextBlock>
                </StackPanel>
            </StackPanel>            
        </Border>
        <!--#endregion-->

        <!--#region Button-->
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="13" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="RistampaButton" Style="{DynamicResource ButtonStyle}" Width="200" Margin="5" Click="RistampaButton_Click">Ristampa</Button>
                <Button x:Name="ModificaButton" Style="{DynamicResource ButtonStyle}" Width="200" Margin="5" Click="ModificaButton_Click">Modifica Sicurezza</Button>
                <Button x:Name="CloseButton" Style="{DynamicResource ButtonStyle}" Width="200" Margin="5" Click="CloseButton_Click" >Chiudi</Button>
            </StackPanel>
        </Border>
        <!--#endregion-->
    </Grid>
</Window>
