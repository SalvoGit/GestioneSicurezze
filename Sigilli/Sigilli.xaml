<Window x:Class="GestioneSicurezze.Sigilli"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneSicurezze"
        mc:Ignorable="d"
        Title="Mezzapesa - Gestione SIGILLI" SizeToContent="WidthAndHeight"
            Background="#F7F8E2" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="75"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>


        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="7">
            <StackPanel Orientation="Horizontal" Margin="5">
                <StackPanel Orientation="Vertical">
                    <Label Content="NR. SIGILLO" Style="{DynamicResource LabelStyle}"></Label>
                    <TextBox x:Name="txtNrSigillo"
                             FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center" 
                                 VerticalContentAlignment="Center"
                             Width="250">                        
                    </TextBox>
                    <Label x:Name="lblSigillo" Style="{StaticResource ErrorLabelStyle}" Padding="5" Content=""></Label>
                </StackPanel>
                
                <StackPanel Orientation="Vertical" Margin="5,0">
                    <Label Content="DESTINAZIONE" Style="{DynamicResource LabelStyle}"></Label>
                    <TextBox x:Name="txtDestinazione"
                             FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center" 
                                 VerticalContentAlignment="Center"
                             Width="250">                        
                    </TextBox>
                    <Label x:Name="lblDestinazione" Style="{StaticResource ErrorLabelStyle}" Padding="5" Content=""></Label>
                </StackPanel>
                
                <StackPanel Orientation="Vertical" Margin="5,0">
                    <Label Content="TARGA" Style="{DynamicResource LabelStyle}"></Label>
                    <TextBox x:Name="txtTarga"
                             FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center" 
                                 VerticalContentAlignment="Center"
                             Width="250">                        
                    </TextBox>
                    <Label x:Name="lblTarga" Style="{StaticResource ErrorLabelStyle}" Padding="5" Content=""></Label>
                </StackPanel>
                
                <StackPanel Orientation="Vertical" Margin="5,0">
                    <Label Content="SOCIETA'" Style="{DynamicResource LabelStyle}"></Label>
                    <TextBox x:Name="txtSocieta"
                             FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center" 
                                 VerticalContentAlignment="Center"
                             Width="250">                        
                    </TextBox>
                    <Label x:Name="lblSocieta" Style="{StaticResource ErrorLabelStyle}" Padding="5" Content=""></Label>
                </StackPanel>
                
            </StackPanel>
        </Border>

        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0">
                <Button x:Name="InsertButton" Style="{DynamicResource ButtonStyle}" Width="175" Margin="5" Click="InsertButton_Click" 
                        >Salva</Button>
                <Button x:Name="CloseButton" Style="{DynamicResource ButtonStyle}" Width="175" Margin="5" Click="CloseButton_Click" 
                        >CHIUDI</Button>                    
                </StackPanel>
        </Border>

        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="7">

            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBox x:Name="txtRicerca" Width="250" VerticalContentAlignment="Center"></TextBox>
                <Label Content="Ricerca per"></Label>
                <ComboBox x:Name="cmbCriteri" Width="250">
                    <ComboBoxItem Content="SIGILLO" IsSelected="True" VerticalContentAlignment="Center"></ComboBoxItem>
                    <ComboBoxItem Content="DESTINAZIONE"></ComboBoxItem>
                    <ComboBoxItem Content="TARGA"></ComboBoxItem>
                    <ComboBoxItem Content="SOCIETÀ" VerticalAlignment="Center"></ComboBoxItem>
                </ComboBox>
                <Button x:Name="SearchButton" Style="{DynamicResource ButtonStyle}" Width="175" 
                        Click="SearchButton_Click" Margin="5,0">Cerca</Button>
                <Button x:Name="ClearButton" Style="{DynamicResource ButtonStyle}" Width="175"
                        Click="ClearButton_Click" Margin="5,0">Cancella Ricerca</Button>
            </StackPanel>

        </Border>

        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="7">
            
                <ListView x:Name="lis_UltimiInseriti" FontSize="16" Margin="5">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nr Sigillo" DisplayMemberBinding="{Binding NRSIGILLO}" Width="250"></GridViewColumn>
                            <GridViewColumn Header="Destinazione" DisplayMemberBinding="{Binding DESTINAZIONE}" Width="250"></GridViewColumn>
                            <GridViewColumn Header="Targa" DisplayMemberBinding="{Binding TARGA}" Width="100"></GridViewColumn>
                            <GridViewColumn Header="Società" DisplayMemberBinding="{Binding TRASPORTATORE}" Width="250"></GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            
        </Border>
    </Grid>
</Window>
