<Window x:Class="GestioneSicurezze.NuovoCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneSicurezze"
        mc:Ignorable="d"
        Title="Inserimento NuovoCliente" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="1">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Cliente: " Style="{StaticResource LabelStyle}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="5,0"/>
                    <TextBox x:Name="ClienteTextBox" Width="300" Height="30" Margin="10,0" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="SaveButton" Content="Salva Cliente" Style="{StaticResource ButtonStyle}" Width="150" Height="40" HorizontalAlignment="Center" Margin="0,10" Click="SaveNewCliente_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
