<Window x:Class="GestioneSicurezze.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneSicurezze"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        x:Name="MainWd"
        Title="Mezzapesa - Gestione Sicurezze" Background="#F7F8E2"        
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Loaded="Window_Loaded" Icon="/Immagini/Logo.png" Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"></ColumnDefinition>
                <ColumnDefinition Width="250"></ColumnDefinition>
                <ColumnDefinition Width="250"></ColumnDefinition>
                <ColumnDefinition Width="250"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="5"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"></RowDefinition>
                <!--Immagine Logo RIGA 0-->
                <RowDefinition Height="5"></RowDefinition>
                <!-- RIGA 1 SPACER-->

                <RowDefinition Height="75"></RowDefinition>
                <!--PROGRESSIVO/CODICE ENAC/OPERATORE/CLIENTE RIGA 2-->
                <RowDefinition Height="5"></RowDefinition>
                <!--RIGA 3 SAPCER-->

                <RowDefinition Height="125"></RowDefinition>
                <!-- ENTRATA/AWB/COLLI/PESO/DESTINAZIONE/CONTENUTO RIGA 4-->
                <RowDefinition Height="5"></RowDefinition>
                <!--RIGA 5 SPACER-->

                <RowDefinition Height="0"></RowDefinition>
                <!-- FRASE RIGA 6-->
                <RowDefinition Height="5"></RowDefinition>
                <!--RIGA 7 SPACER-->

                <RowDefinition Height="100"></RowDefinition>
                <!--RIFERIMENTI RIGA 8-->
                <RowDefinition Height="5"></RowDefinition>
                <!--RIGA 9 SPACER-->

                <RowDefinition Height="125"></RowDefinition>
                <!--TIPO ISPEZIONE RIGA 10-->
                <RowDefinition Height="5"></RowDefinition>
                <!--RIGA 11 SPACER-->

                <RowDefinition Height="50"></RowDefinition>
                <!--DATA/ORA AEREOPORTO RIGA 12-->
                <RowDefinition Height="5"></RowDefinition>
                <!--RIGA 13 SPACER-->

                <RowDefinition Height="50"></RowDefinition>
                <!--BUTTON RIGA 14-->
                <RowDefinition Height="5"></RowDefinition>
                <!--RIGA 15 SPACER-->

                <RowDefinition Height="*"></RowDefinition>
                <!-- ULTIMI INSERIMENTI RIGA 16-->
                <RowDefinition Height="5"></RowDefinition>
                <!--RIGA 17 SPACER-->

            </Grid.RowDefinitions>

            <!--#region Immaggine Testa-->
            <StackPanel Orientation="Horizontal" Margin="0,5"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="0">
                <Image Source="/Immagini/TopImage.jpg"></Image>
            </StackPanel>
            <!--#endregion-->

            <!--#region Riga Progressivo CodiceEU Operatore Cliente-->
            <Border Style="{StaticResource BorderStyle}"
                    Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!--#region PROGRESSIVO-->
                    <StackPanel Margin="15,0" Orientation="Horizontal" Visibility="Collapsed">
                        <Label Style="{DynamicResource LabelStyle}" Content="PROGRESSIVO:"></Label>
                        <TextBlock Name="txtProgressivo" Style="{DynamicResource TextBlockStyle}"
                                   Text="12345"></TextBlock>
                    </StackPanel>
                    <!--#endregion-->

                    <!--#region CODICE ENAC-->
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="5,0,5,10" VerticalAlignment="Center">
                            <Label Style="{DynamicResource LabelStyle}" Content="CODICE EU:"></Label>
                            <ComboBox x:Name="ComboEnac" FontFamily="Verdana"
                                      FontSize="20" FontWeight="Bold" Width="230"
                                      DisplayMemberPath="Codice_EU"
                                      SelectedValuePath="Codice_EU" SelectedIndex="0">
                            </ComboBox>
                            <Button x:Name="btnRefreshCodiceEnac" Style="{DynamicResource ButtonStyle}" Click="AggiornaListaEnac"
                                    Width="30" Margin="5,0" ToolTip="Aggiorna Codice Enac">
                                <Image Source="/Immagini/refresh.png"></Image>
                            </Button>
                        </StackPanel>
                        <Label x:Name="lblCodEU" Style="{StaticResource ErrorLabelStyle}" Height="15" Padding="0" Margin="0,5,0,0"></Label>
                    </StackPanel>
                    <!--#endregion-->

                    <!--#region OPERATORE-->
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="5,0,5,10">
                            <Label Style="{DynamicResource LabelStyle}" Content="OPERATORE:"></Label>
                            <ComboBox x:Name="ComboOperatori" SelectedIndex="0" FontFamily="Verdana"
                                      FontSize="20" FontWeight="Bold" Width="75"
                                      DisplayMemberPath="Codice_Operatore" SelectedValuePath="Codice_Operatore">
                            </ComboBox>
                            <Button x:Name="btnRefreshCodiceOperatore" Style="{DynamicResource ButtonStyle}" Click="AggiornaListaOperatori"
                                    Width="30" Margin="5,0" ToolTip="Aggiorna Codici Operatore">
                                <Image Source="/Immagini/refresh.png"></Image>
                            </Button>
                        </StackPanel>
                        <Label x:Name="lblOperatore" Style="{StaticResource ErrorLabelStyle}" Height="15" Padding="0" Margin="0,5,0,0"></Label>
                    </StackPanel>
                    <!--#endregion-->

                    <!--#region CLIENTE-->
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="5,0,5,10">
                            <Label Style="{DynamicResource LabelStyle}" Content="SPEDIZIONE AFFIDATA DA:"></Label>
                            <ComboBox x:Name="ComboCliente" SelectedIndex="0"
                                  FontFamily="Verdana" FontSize="20"
                                  FontWeight="Bold" Width="360"
                                  IsEditable="True" DisplayMemberPath="Cliente" SelectedValuePath="Cliente">
                            </ComboBox>
                            <Button x:Name="btnRefreshCliente" Style="{DynamicResource ButtonStyle}" 
                                    Width="30" Margin="5,0" ToolTip="Aggiorna Clienti"
                                    Click="AggiornaListaClienti">
                                <Image Source="/Immagini/refresh.png"></Image>
                            </Button>
                        </StackPanel>
                        <Label x:Name="lblCliente" Style="{StaticResource ErrorLabelStyle}" Height="15" Padding="0" Margin="0,5,0,0"></Label>
                    </StackPanel>
                    <!--#endregion-->
                </StackPanel>
            </Border>
            <!--#endregion-->

            <!--#region ENTRATA AWB COLLI KG DEST CONTENUTO-->
            <Border Style="{StaticResource BorderStyle}"
                    Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="4" >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="center"
                            Margin="5" >
                    <Border BorderThickness="1,0" BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"></ColumnDefinition>
                                <ColumnDefinition Width="300"></ColumnDefinition>
                                <ColumnDefinition Width="250"></ColumnDefinition>
                                <ColumnDefinition Width="200"></ColumnDefinition>
                                <ColumnDefinition Width="350"></ColumnDefinition>
                                <ColumnDefinition Width="200"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>

                            <Label Content="ENTRATA NR." HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="0" Grid.Row="0" />
                            <Label Content="AWB" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="1" Grid.Row="0" />
                            <Label Content="COLLI" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="2" Grid.Row="0" />
                            <Label Content="KG" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="3" Grid.Row="0" />
                            <Label Content="DEST" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="4" Grid.Row="0" />
                            <Label Content="CONTENUTO" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="5" Grid.Row="0" />

                            <Border Grid.Column="0" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="txtEntrata" FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center" 
                                                 VerticalContentAlignment="Center" Width="255"></TextBox>
                                        <Button x:Name="btnAddEntrata" Content="+" Margin="5,5,0,5" Width="25" Visibility="Hidden"
                                                Style="{DynamicResource ButtonStyle}" ToolTip="Aggiungi Entrate Multiple" Click="btnAddEntrata_Click"></Button>
                                    </StackPanel>

                                    <Label x:Name="lblEntrata" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                                <StackPanel Orientation="Vertical">
                                    <TextBox x:Name="txtAwb" FontFamily="Verdana" FontSize="16" Padding="5" VerticalContentAlignment="Center"
                                             Margin="5" HorizontalContentAlignment="Center" />
                                    <Label x:Name="lblAWB" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                                <StackPanel Orientation="Vertical">
                                    <TextBox x:Name="txtColli" FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center"
                                             PreviewTextInput="OnlyNumbers" VerticalContentAlignment="Center"></TextBox>
                                    <Label x:Name="lblColli" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                                <StackPanel Orientation="Vertical">
                                    <TextBox x:Name="txtPeso" FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center"
                                             PreviewTextInput="OnlyNumbers" VerticalContentAlignment="Center"></TextBox>
                                    <Label x:Name="lblPeso" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                                <StackPanel Orientation="Vertical">
                                    <TextBox x:Name="txtDestinazione" FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center" 
                                             VerticalContentAlignment="Center"></TextBox>
                                    <Label x:Name="lblDestinazione" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="5" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                                <StackPanel Orientation="Vertical">
                                    <TextBox x:Name="txtContenuto" FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center" Text="VARIE"></TextBox>
                                    <Label x:Name="lblContenuto" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <!--#endregion-->

            <!--#region Frase-->
            <!--<StackPanel Orientation="Horizontal" Grid.Column="1" Grid.ColumnSpan="4" Margin="15,0,0,0"
                        Grid.Row="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Sono state protette contro ogni interferenza illecita dalla consegna fino all'imbarco delle stesse sui voli / aviocamionati in partenza da questo aeroporto:"
                   FontFamily="Verdana" FontSize="14" FontWeight="Bold">
                </TextBlock>
            </StackPanel>-->
            <!--#endregion-->

            <!--#region Compilazione Riferimenti-->
            <Border Style="{StaticResource BorderStyle}"
                    Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="8">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="400"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition Height="10"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Style="{DynamicResource LabelStyle}" Grid.Column="0" Grid.Row="0"
                               Content="Autista:"></Label>
                        <ComboBox x:Name="ComboAutista" SelectedIndex="-1" Grid.Column="1" Grid.Row="0"
                                  FontFamily="Verdana" FontSize="20" Margin="5,0,5,0"
                                  FontWeight="Bold" IsEditable="True" DisplayMemberPath="Autista"
                                  SelectedValuePath="ID" SelectionChanged="ComboAutista_SelectionChanged"
                                  Height="31" Grid.RowSpan="2" VerticalAlignment="Top"
                                  LostFocus="ComboAutista_LostFocus">
                        </ComboBox>
                        <Label Style="{DynamicResource LabelStyle}" Grid.Column="2" Grid.Row="0"
                               Content="Trasportatore/Rag. Soc.:"></Label>
                        <TextBox x:Name="txtRagSocTrasp" FontFamily="Verdana" FontSize="14"
                                 Width="300" Padding="5" Grid.Column="3" Grid.Row="0" Margin="5,0"></TextBox>
                        <Label Style="{DynamicResource LabelStyle}" Grid.Column="4" Grid.Row="0"
                               Content="Targhe:"></Label>
                        <TextBox x:Name="txtTarghe" FontFamily="Verdana" FontSize="14"
                                 Width="300" Padding="5" Grid.Column="5" Grid.Row="0" Margin="5,0"></TextBox>
                        <Label Style="{DynamicResource LabelStyle}" Grid.Column="0" Grid.Row="2"
                               Content="Sigillo Numero:"></Label>
                        <TextBox x:Name="txtSigilloNumero" FontFamily="Verdana" FontSize="14"
                                 Width="400" Padding="5" Grid.Column="1" Grid.Row="2" Margin="5,0"></TextBox>
                        <Label Style="{DynamicResource LabelStyle}" Grid.Column="2" Grid.Row="2"
                               Content="Riferimento:"></Label>
                        <TextBox x:Name="txtRiferimento" FontFamily="Verdana" FontSize="14"
                                 Width="300" Padding="5" Grid.Column="3" Grid.Row="2" Margin="5,0"></TextBox>

                        <!--<TextBox x:Name="txtAutista" FontFamily="Verdana" FontSize="14"
                                 Width="300" Padding="5" Grid.Column="3" Grid.Row="2" Margin="5,0"></TextBox>-->
                    </Grid>
                </StackPanel>
            </Border>
            <!--#endregion-->

            <!--#region Check Xray-->
            <Border Style="{StaticResource BorderStyle}"
                    Grid.Column="1" Grid.Row="10" Grid.ColumnSpan="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!--#region XRAY-->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Background="White" Margin="0,5">
                        <StackPanel HorizontalAlignment="Center">
                            <Label Style="{DynamicResource LabelStyle}"
                                   Content="TIPO ISPEZIONE"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="5,10">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Vertical" Margin="0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="chXray" Content="XRAY" FontFamily="Verdana" FontSize="14"
                                                  Margin="5,0" FontWeight="Bold" IsChecked="True"
                                                  VerticalAlignment="Center"></CheckBox>
                                        <StackPanel Orientation="Vertical">
                                            <Label Style="{DynamicResource LabelStyle}" Content="Qt.:" 
                   HorizontalAlignment="Center"></Label>
                                            <TextBox x:Name="txtQtXray" Text="0" FontSize="14" FontWeight="Bold"
                     VerticalContentAlignment="Top" PreviewTextInput="OnlyNumbers"
                     HorizontalContentAlignment="Center" Margin="0,0">
                                            </TextBox>
                                        </StackPanel>
                                    </StackPanel>
                                    <Label x:Name="lblQtRayError" Style="{DynamicResource ErrorLabelStyle}"></Label>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,10">
                                    <CheckBox x:Name="chEtd" Content="ETD" FontFamily="Verdana" FontSize="14"
              Margin="5,0" FontWeight="Bold"
              VerticalAlignment="Center"></CheckBox>
                                    <StackPanel Orientation="Vertical">
                                        <Label Style="{DynamicResource LabelStyle}" Content="Qt.:" 
               HorizontalAlignment="Center"></Label>
                                        <TextBox x:Name="txtQtEtd" Text="0" FontSize="14" FontWeight="Bold"
                 VerticalContentAlignment="Top" PreviewTextInput="OnlyNumbers"
                 HorizontalContentAlignment="Center" Margin="0,0">
                                        </TextBox>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>




                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                <CheckBox x:Name="chPhs" Content="PHS (Ispezione Manuale)" FontFamily="Verdana" FontSize="14"
                                          Margin="5,0" FontWeight="Bold"></CheckBox>
                                <CheckBox x:Name="chVck" Content="VCK (Ispezione Visiva Completa)" FontFamily="Verdana" FontSize="14" 
                                          Margin="5,0" FontWeight="Bold"></CheckBox>
                            </StackPanel>

                        </StackPanel>
                    </StackPanel>
                    <!--#endregion-->

                    <!--#region STATO DELLA MERCE-->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Background="White" Margin="25,5,0,5">
                        <StackPanel HorizontalAlignment="Center">
                            <Label Style="{DynamicResource LabelStyle}" Content="STATO DELLA MERCE"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="5,10">
                            <RadioButton x:Name="rbSpx" Content="SPX (sicura per ogni tipo di aeromobile)" FontFamily="Verdana" FontSize="14"
                                             Margin="5,0" FontWeight="Bold" IsChecked="True">
                            </RadioButton>
                            <RadioButton x:Name="rbShr" Content="SHR (sicura solo per trasporto con aeromobili &quot;all cargo&quot; o postali)"
                                             FontFamily="Verdana" FontSize="14" Margin="5,0" FontWeight="Bold">
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                    <!--#endregion-->
                </StackPanel>
            </Border>
            <!--#endregion-->

            <!--#region ORA/DATA DESTINAZIONE -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="12" Grid.ColumnSpan="4"
                        HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Style="{DynamicResource LabelStyle}" Content="Data/Ora Rilascio sicurezza:"></Label>
                    <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                       Style="{DynamicResource TextBlockStyle}"
                       Foreground="#ff7b00"></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="45,0">
                    <Label Style="{DynamicResource LabelStyle}" Content="Aeroporto Destinazione:"></Label>
                    <TextBox x:Name="txtAeroporto" Width="350" FontFamily="Verdana" FontSize="14" VerticalContentAlignment="Center"></TextBox>
                </StackPanel>
            </StackPanel>
            <!--#endregion-->

            <!--#region Button-->
            <Border Style="{StaticResource BorderStyle}"
                    Grid.Column="1" Grid.Row="14" Grid.ColumnSpan="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="SaveOnlyButton" Click="Save" Style="{DynamicResource ButtonStyle}" Width="150"
                            Margin="5">Salva</Button>
                    <Button x:Name="SaveButton" Click="SavePrint" Style="{DynamicResource ButtonStyle}" Width="150"
                            Margin="5">Salva + Stampa</Button>
                    <Button x:Name="SearchButton" Style="{DynamicResource ButtonStyle}" Width="150" Click="SearchButton_Click" Margin="5">Ricerca Sicurezza</Button>
                    <Button x:Name="NuoOpButton" Style="{DynamicResource ButtonStyle}" Width="150" Click="InsertNuovoOperatore" Margin="5">Nuovo Operatore</Button>
                    <Button x:Name="NuovoClienteButton" Style="{DynamicResource ButtonStyle}" Width="150" Click="NuovoClienteButton_Click" Margin="5">Nuovo Cliente</Button>
                    <Button x:Name="NuovoAutistaButton" Style="{DynamicResource ButtonStyle}" Width="200" Click="NuovoAutistaButton_Click" Margin="5">Gestione Autista/Targa</Button>
                    <Button x:Name="SettingsButton" Click="OpenSettings" Style="{DynamicResource ButtonStyle}" Width="150" Margin="5">Settings</Button>
                    <Button x:Name="UpdateButton" IsEnabled="False" Visibility="Collapsed" Style="{DynamicResource UpdateStyle}" Width="200" Margin="5" Click="UpdateButton_Click">Installa Aggiornamenti</Button>
                    <!--<Button x:Name="SigilliButton" Visibility="Hidden" Style="{DynamicResource ButtonStyle}" Width="150" Margin="5" Click="SigilliButton_Click">Sigilli</Button>-->
                </StackPanel>
            </Border>
            <!--#endregion-->

            <!--#region Ultimi Inserimenti-->
            <Border Style="{StaticResource BorderStyle}" Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="4">
                <StackPanel Orientation="Vertical">
                    <StackPanel>
                        <Label Style="{DynamicResource LabelStyle}" Content="SICUREZZE INSERITE:" HorizontalAlignment="Center" FontSize="26"></Label>
                    </StackPanel>
                    <StackPanel Margin="5,5">
                        <ListView x:Name="lis_UltimiInseriti" FontSize="16">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="PROG." Width="50" DisplayMemberBinding="{Binding Progressivo}"></GridViewColumn>
                                    <GridViewColumn Header="ENTR. NR." Width="125" DisplayMemberBinding="{Binding NrEntrata}"></GridViewColumn>
                                    <GridViewColumn Header="CODICE-EU" Width="100" DisplayMemberBinding="{Binding CodiceEnac}"></GridViewColumn>
                                    <GridViewColumn Header="OP." Width="50" DisplayMemberBinding="{Binding Operatore}"></GridViewColumn>
                                    <GridViewColumn Header="CLIENTE" Width="250" DisplayMemberBinding="{Binding Cliente}"></GridViewColumn>
                                    <GridViewColumn Header="AWB" Width="100" DisplayMemberBinding="{Binding Awb}"></GridViewColumn>
                                    <GridViewColumn Header="COLLI" Width="50" DisplayMemberBinding="{Binding Colli}"></GridViewColumn>
                                    <GridViewColumn Header="KG" Width="50" DisplayMemberBinding="{Binding Peso}"></GridViewColumn>
                                    <GridViewColumn Header="DESTIN." Width="75" DisplayMemberBinding="{Binding Destinazione}"></GridViewColumn>
                                    <GridViewColumn Header="CONTENUTO" Width="100" DisplayMemberBinding="{Binding Contenuto}"></GridViewColumn>
                                    <GridViewColumn Header="XRAY" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding XRAY}" HorizontalAlignment="Center"></CheckBox>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="ETD" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding ETD}"></CheckBox>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="PHS" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding PHS}"></CheckBox>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="VCK" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding VCK}"></CheckBox>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="STATO MERCE" Width="125" DisplayMemberBinding="{Binding STATOMERCE}"></GridViewColumn>

                                    <GridViewColumn Header="AEROPORTO DESTIN." Width="300" DisplayMemberBinding="{Binding AeroportoDest}"></GridViewColumn>

                                    <GridViewColumn Header="AZIONI" Width="auto">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="Modifica" Padding="2,5" Background="Green" Foreground="White" Click="Modifica_Click" Tag="{Binding}"></Button>
                                                    <Button Content="Elimina" Padding="2,5" Margin="5,0,0,0" Background="Tomato" Foreground="White" Click="Delete_Click" Tag="{Binding}">
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!--#endregion-->
        </Grid>
    </ScrollViewer>

</Window>
