<Window x:Class="GestioneSicurezze.ModificaEntrate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneSicurezze"
        mc:Ignorable="d"
        Title="Mezzapesa - Gestione Sicurezze - Modifica Entrata" SizeToContent="WidthAndHeight"
        Background="#F7F8E2" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>            
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="75"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        
        <!--#region Riga Progressivo CodiceEU Operatore Cliente-->
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Margin="15,0" Orientation="Horizontal" VerticalAlignment="Top">
                    <Label Style="{DynamicResource LabelStyle}" Content="PROGRESSIVO:"></Label>
                    <TextBlock Name="txtProgressivo" FontFamily="Verdana" FontSize="20" FontWeight="Bold"
                        Text="1232113" VerticalAlignment="Center"></TextBlock>
                </StackPanel>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center">
                        <Label Style="{DynamicResource LabelStyle}" Content="CODICE EU:"></Label>
                        <ComboBox x:Name="ComboEnac" FontFamily="Verdana"
                          FontSize="20" FontWeight="Bold" Width="230"
                          DisplayMemberPath="Codice_EU"
                          SelectedValuePath="Codice_EU" SelectedIndex="0">
                        </ComboBox>
                    </StackPanel>
                    <Label x:Name="lblCodEU" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                </StackPanel>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <Label Style="{DynamicResource LabelStyle}" Content="OPERATORE:"></Label>
                        <ComboBox x:Name="ComboOperatori" SelectedIndex="0" FontFamily="Verdana"
                          FontSize="20" FontWeight="Bold" Width="75"
                          DisplayMemberPath="Codice_Operatore" SelectedValuePath="Codice_Operatore">
                        </ComboBox>
                    </StackPanel>
                    <Label x:Name="lblOperatore" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                </StackPanel>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <Label Style="{DynamicResource LabelStyle}" Content="SPEDIZIONE AFFIDATA DA:"></Label>
                        <ComboBox x:Name="ComboCliente" SelectedIndex="0"
                      FontFamily="Verdana" FontSize="20"
                      FontWeight="Bold" Width="360"
                      IsEditable="True" Margin="15,0,0,0" DisplayMemberPath="Cliente" SelectedValuePath="Cliente">
                        </ComboBox>
                    </StackPanel>
                    <Label x:Name="lblCliente" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                </StackPanel>
            </StackPanel>
        </Border>
        <!--#endregion-->

        <!--#region ENTRATA AWB COLLI KG DEST CONTENUTO-->
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                Margin="5,25,5,5" >
                <Border BorderThickness="1,0" BorderBrush="Black">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Label Content="ENTRATA NR." HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="0" Grid.Row="0" />
                        <Label Content="AWB" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="1" Grid.Row="0" />
                        <Label Content="COLLI" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="2" Grid.Row="0" />
                        <Label Content="KG" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="3" Grid.Row="0" />
                        <Label Content="DEST" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="4" Grid.Row="0" />
                        <Label Content="CONTENUTO" HorizontalAlignment="Center" Style="{DynamicResource LabelStyle}" Grid.Column="5" Grid.Row="0" />

                        <Border Grid.Column="0" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                            <StackPanel Orientation="Vertical">
                                <TextBox x:Name="txtEntrata" FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center" 
                                 VerticalContentAlignment="Center"></TextBox>
                                <Label x:Name="lblEntrata" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                            <StackPanel Orientation="Vertical">
                                <TextBox x:Name="txtAwb" FontFamily="Verdana" FontSize="16" Padding="5" VerticalContentAlignment="Center" Margin="5" HorizontalContentAlignment="Center" />
                                <Label x:Name="lblAWB" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                            <StackPanel Orientation="Vertical">
                                <TextBox x:Name="txtColli" FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"></TextBox>
                                <Label x:Name="lblColli" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                            <StackPanel Orientation="Vertical">
                                <TextBox x:Name="txtPeso" FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"></TextBox>
                                <Label x:Name="lblPeso" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                            <StackPanel Orientation="Vertical">
                                <TextBox x:Name="txtDestinazione" FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center" 
                                 VerticalContentAlignment="Center"></TextBox>
                                <Label x:Name="lblDestinazione" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="5" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="Black">
                            <StackPanel Orientation="Vertical">
                                <TextBox x:Name="txtContenuto" FontFamily="Verdana" FontSize="16" Padding="5" Margin="5" HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center" Text="VARIE"></TextBox>
                                <Label x:Name="lblContenuto" Style="{StaticResource ErrorLabelStyle}" Padding="5"></Label>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <!--#endregion-->

        <!--#region Compilazione Riferimenti-->
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="5">
            <StackPanel Orientation="Vertical"
                HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition Height="10"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Label Style="{DynamicResource LabelStyle}" Grid.Column="0" Grid.Row="0"
            Content="Riferimento:"></Label>
                    <TextBox x:Name="txtRiferimento" FontFamily="Verdana" FontSize="14" Width="300" Padding="5" Grid.Column="1" Grid.Row="0"
            Margin="5,0"></TextBox>
                    <Label Style="{DynamicResource LabelStyle}" Grid.Column="2" Grid.Row="0"
            Content="Trasportatore/Rag. Soc.:"></Label>
                    <TextBox x:Name="txtRagSocTrasp" FontFamily="Verdana" FontSize="14" Width="300" Padding="5" Grid.Column="3" Grid.Row="0"
            Margin="5,0"></TextBox>
                    <Label Style="{DynamicResource LabelStyle}" Grid.Column="4" Grid.Row="0"
            Content="Targhe:"></Label>
                    <TextBox x:Name="txtTarghe" FontFamily="Verdana" FontSize="14" Width="300" Padding="5" Grid.Column="5" Grid.Row="0"
            Margin="5,0"></TextBox>
                    <Label Style="{DynamicResource LabelStyle}" Grid.Column="0" Grid.Row="2"
            Content="Sigillo Numero:"></Label>
                    <TextBox x:Name="txtSigilloNumero" FontFamily="Verdana" FontSize="14" Width="300" Padding="5" Grid.Column="1" Grid.Row="2"
            Margin="5,0"></TextBox>
                    <Label Style="{DynamicResource LabelStyle}" Grid.Column="2" Grid.Row="2"
            Content="Autista:"></Label>
                    <TextBox x:Name="txtAutista" FontFamily="Verdana" FontSize="14" Width="300" Padding="5" Grid.Column="3" Grid.Row="2"
            Margin="5,0"></TextBox>
                </Grid>
            </StackPanel>
        </Border>
        <!--#endregion-->
        
        <!--#region Check Xray-->
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!--#region XRAY-->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="400">
                    <Grid Margin="5,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Style="{DynamicResource LabelStyle}" HorizontalAlignment="Center"
                               Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Content="TIPO ISPEZIONE"></Label>
                        
                        <CheckBox x:Name="chXray" Content="XRAY" FontFamily="Verdana" FontSize="14"
                                  Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"
                                  Margin="5,0" FontWeight="Bold" IsChecked="True"></CheckBox>
                        <TextBox x:Name="txtQtXray" Grid.Column="1" Grid.Row="1" Margin="5,0"/>

                        <CheckBox x:Name="chEtd" Content="ETD" FontFamily="Verdana" FontSize="14"
                                  Grid.Column="0" Grid.Row="2" VerticalAlignment="Center"
                                  Margin="5,0" FontWeight="Bold"></CheckBox>
                        <TextBox x:Name="txtQtEtd" Grid.Column="1" Grid.Row="2" Margin="5,0"/>

                        <CheckBox x:Name="chPhs" Content="PHS (Ispezione Manuale)" FontFamily="Verdana" FontSize="14"
                                  Grid.Column="0" Grid.Row="3" VerticalAlignment="Center"
                                  Margin="5,10" FontWeight="Bold"></CheckBox>                        

                        <CheckBox x:Name="chVck" Content="VCK (Ispezione Visiva Completa)" FontFamily="Verdana" FontSize="14"
                                  Grid.Column="0" Grid.Row="4" VerticalAlignment="Center"
                                  Margin="5,10" FontWeight="Bold"></CheckBox>
                    </Grid>                    
                </StackPanel>
                <!--#endregion-->
                <!--#region STATO DELLA MERCE-->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="150,0">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Label Style="{DynamicResource LabelStyle}" Content="STATO DELLA MERCE"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="5,10" HorizontalAlignment="Center">
                            <RadioButton x:Name="rbSpx" Content="SPX (sicura per ogni tipo di aeromobile)"
                                         FontFamily="Verdana" FontSize="14"
                                         Margin="15,10" FontWeight="Bold" IsChecked="True">
                            </RadioButton>
                            <RadioButton x:Name="rbShr"
                                         Content="SHR (sicura solo per trasporto con aeromobili &quot;all cargo&quot; o postali)"
                                         FontFamily="Verdana" FontSize="14"
                                         Margin="15,10" FontWeight="Bold">
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!--#endregion-->
            </StackPanel>
        </Border>
        <!--#endregion-->

        <!--#region ORA/DATA DESTINAZIONE -->
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="9">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Style="{DynamicResource LabelStyle}" Content="Data/Ora Rilascio sicurezza:"></Label>
                    <TextBlock x:Name="txtDataOra" FontFamily="Verdana" FontSize="16" VerticalAlignment="Center" Margin="5,0"
                   Foreground="#ff7b00" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                    <Label Style="{DynamicResource LabelStyle}" Content="Aeroporto Destinazione:"></Label>
                    <TextBox x:Name="txtAeroporto" Width="350" FontFamily="Verdana" FontSize="14" VerticalContentAlignment="Center"></TextBox>
                </StackPanel>
            </StackPanel>
        </Border>        
        <!--#endregion-->

        <!--#region Button-->
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="11" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UpdateButton" Style="{DynamicResource ButtonStyle}" Width="175" Margin="5" Click="UpdateButton_Click">Aggiorna + Stampa</Button>
                <!--<Button x:Name="AggiornaRistampaButton" Style="{DynamicResource ButtonStyle}" Width="175" Margin="5">Aggiorna e Ristampa</Button>-->
                <Button x:Name="RistampaButton" Style="{DynamicResource ButtonStyle}" Width="150" Margin="5" Click="RistampaButton_Click">Ristampa Attuale</Button>
                <Button x:Name="UpdateCloseButton" Style="{DynamicResource ButtonStyle}" Width="150" Margin="5" Click="UpdateCloseButton_Click" >Aggiorna e Chiudi</Button>
                <Button x:Name="CloseButton" Style="{DynamicResource ButtonStyle}" Width="150" Margin="5" Click="CloseButton_Click" >Chiudi</Button>
            </StackPanel>
        </Border>
        <!--#endregion-->
    </Grid>
</Window>
