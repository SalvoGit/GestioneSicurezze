<Window x:Class="GestioneSicurezze.NuovoOperatore"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneSicurezze"
        mc:Ignorable="d"
        Title="Inserimento Nuovo Operatore" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="1">
            <StackPanel Orientation="Vertical" Margin="10">
                <Label Style="{StaticResource LabelStyle}" Content="Inserimento Nuovo Operatore" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Label Style="{StaticResource LabelStyle}" Content="Operatore Numero:" Grid.Column="0" Grid.Row="0" Margin="10"/>
                    <TextBox x:Name="NewOpCodtxt" Width="150" Height="30" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" Margin="10" VerticalContentAlignment="Center"></TextBox>
                    
                    <Label Style="{StaticResource LabelStyle}" Content="Nome Cognome*:" Grid.Column="0" Grid.Row="1" Margin="10"/>
                    <TextBox x:Name="NewOpNomCogntxt" Width="150" Height="30" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="10" VerticalContentAlignment="Center"></TextBox>                    

                    <Label Style="{StaticResource LabelStyle}" Content="Sede:" Grid.Column="0" Grid.Row="2" Margin="10"/>
                    <TextBox x:Name="NewSedetxt" Width="150" Height="30" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="10" VerticalContentAlignment="Center"></TextBox>

                    <Label Style="{StaticResource LabelStyle}" Content="*Campi non obbligatori" Grid.Column="0" Grid.Row="3" FontSize="12" Foreground="Black"/>

                    <Button Style="{StaticResource ButtonStyle}" Content="Salva Operatore" Grid.Column="0" Grid.ColumnSpan="2" Height="50"
                            Grid.Row="4" Width="150" HorizontalAlignment="Center" Margin="10" Click="SaveNewOperator_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
