<Window x:Class="GestioneSicurezze.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneSicurezze"
        mc:Ignorable="d"
        Title="Mezzapesa - Gestione Sicurezze - Settings" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" WindowState="Normal" Loaded="LoadPrinter" Height="238">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>            
            <ColumnDefinition Width="5"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="5"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="1" Margin="0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                </Grid.RowDefinitions>
                <Label Content="Selezione Stampante" Style="{StaticResource LabelStyle}" FontSize="12"
                       Grid.Column="0" Grid.Row="1"/>
                <ComboBox x:Name="PrinterComboBox" Width="350" Height="25" Margin="5,0" HorizontalAlignment="Left"
                          Grid.Column="1" Grid.Row="1" VerticalContentAlignment="Center"/>
                <Label Content="Numero Copie" Style="{StaticResource LabelStyle}" FontSize="12" Grid.Column="0" Grid.Row="3"/>
                <TextBox x:Name="NumeroCopieTextBox" Width="350" Height="25" Margin="5,0" Text="1"
                         Grid.Column="1" Grid.Row="3" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>
                <Label Content="Path Salvataggio" Style="{StaticResource LabelStyle}" FontSize="12" Grid.Column="0" Grid.Row="5"/>
                <TextBox x:Name="txtSavePath" Width="350" Height="25" Margin="5,0" Text="1"
                        Grid.Column="1" Grid.Row="5" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>
                <Button Content="Sfoglia" Style="{StaticResource ButtonStyle}" Width="200" Height="30" Grid.Column="2"
                        Grid.Row="5" HorizontalAlignment="Left" Margin="5,0" Click="Button_Click"/>
                <Label Content="Stampa Sicurezza" Style="{StaticResource LabelStyle}" FontSize="12" Grid.Column="0" Grid.Row="7"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="7">
                    <RadioButton x:Name="rbPrintYes" VerticalContentAlignment="Center" GroupName="StampaSicurezza" IsChecked="True"
                                 Margin="5,0">
                        SI
                    </RadioButton>
                    <RadioButton x:Name="rbPrintNo" VerticalContentAlignment="Center" GroupName="StampaSicurezza" Margin="15,0">
                        NO
                    </RadioButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5"
                            Grid.Column="0" Grid.Row="9" Grid.ColumnSpan="3" HorizontalAlignment="Center" >
                    <Button Content="Salva Impostazioni" Style="{StaticResource ButtonStyle}" Width="200" Height="30" Click="SaveSettings"/>
                    <Button Content="Salva ed Esci" Style="{StaticResource ButtonStyle}" Width="200" Height="30" Margin="5,0" Click="SaveSettingsClose"/>
                    <Button Content="Esci" Style="{StaticResource ButtonStyle}" Width="200" Height="30" Margin="5,0" Click="Close"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

    