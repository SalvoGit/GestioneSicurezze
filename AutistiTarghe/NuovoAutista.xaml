<Window x:Class="GestioneSicurezze.AutistiTarghe.NuovoAutista"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneSicurezze.AutistiTarghe"
        mc:Ignorable="d"
        Title="Inserimento Nuovo Autista/Targa/Ragione Sociale" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="5"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="5"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="5"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="5"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="5"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Autista:" Style="{StaticResource LabelStyle}" 
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="5,0"
                           Grid.Column="0" Grid.Row="0"/>
                    <TextBox x:Name="AutistaTextBox" Width="300" Height="30" 
                             Margin="10,0" VerticalContentAlignment="Center"
                             Grid.Column="1" Grid.Row="0"/>
                    <Label x:Name="lblAutista" Style="{StaticResource ErrorLabelStyle}"
                           Height="15" Grid.Column="1" Grid.Row="1" Margin="5,0"></Label>
                </Grid>                
            </StackPanel>
        </Border>

        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3">            
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                        <Label Content="Targa:" Style="{StaticResource LabelStyle}" FontSize="20"
                               FontWeight="Bold" HorizontalAlignment="Left" Margin="5,0"
                               Grid.Column="0"/>
                    <TextBox x:Name="TargaTextBox" Width="300" Height="30" Grid.Column="1"
                             Margin="10,0" VerticalContentAlignment="Center"/>
                     <Label x:Name="lblTarga" Style="{StaticResource ErrorLabelStyle}"
                            Height="15" Grid.Column="1" Grid.Row="1" Margin="5,0" Grid.ColumnSpan="2"></Label>
                    
                    </Grid>                
            </StackPanel>            
        </Border>

        
        
        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="3">
            
            <StackPanel Orientation="Horizontal" Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Rag. Soc.:" Style="{StaticResource LabelStyle}" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Left" Margin="5,0"
                           Grid.Column="0" Grid.Row="0"/>
                    <TextBox x:Name="RagioneSocialeTextBox" Width="300" Height="30" Margin="10,0"
                             VerticalContentAlignment="Center"
                             Grid.Column="1" Grid.Row="0"/>
                    <Label x:Name="lblRagSoc" Style="{StaticResource ErrorLabelStyle}"
                           Grid.ColumnSpan="2"
                           Height="15" Grid.Column="1" Grid.Row="1" Margin="5,0"></Label>
                </Grid>                
            </StackPanel>
        </Border>

        <Border Style="{StaticResource BorderStyle}" Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="SaveButton" Content="Salva" Style="{StaticResource ButtonStyle}" 
                        Width="150" Height="40" HorizontalAlignment="Center" Margin="10,0" Click="SaveNewCliente_Click"/>
                <Button x:Name="ExitButton" Content="Esci" Style="{StaticResource ButtonStyle}"
                        Width="150" Height="40" HorizontalAlignment="Center" Margin="10,0" Click="ExitButton_Click"/>
            </StackPanel>
        </Border>

    </Grid>
    
</Window>
